# Copy this file to .env.local and add the real values.
# Find both values in Supabase Dashboard > Project > Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used to build absolute URLs outside Vercel. VERCEL_URL is provided automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1B server-only account bootstrap values. Never expose these with a
# NEXT_PUBLIC_ prefix and never commit populated values.
SUPABASE_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
