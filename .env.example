# Copy this file to .env.local and add the real values.
# Find both values in Supabase Dashboard > Project > Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used to build absolute URLs outside Vercel. VERCEL_URL is provided automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1B server-only account bootstrap values. Never expose these with a
# NEXT_PUBLIC_ prefix and never commit populated values.
SUPABASE_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=assemkh
BOOTSTRAP_ADMIN_DISPLAY_NAME=Assem
BOOTSTRAP_FAMILY_NAME=Assem Family

# Optional Phase 1.A observability. The endpoint receives only an allowlisted
# Web Vitals payload; leave it empty until a trusted analytics sink is chosen.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Optional hosted E2E identities. Prefer the disposable local Supabase fixture;
# never commit populated passwords or browser storage-state files.
E2E_OWNER_IDENTIFIER=
E2E_OWNER_PASSWORD=
E2E_MEMBER_IDENTIFIER=
E2E_MEMBER_PASSWORD=
